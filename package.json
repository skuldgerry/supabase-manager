{
  "name": "supabase-manager",
  "version": "0.1.2",
  "private": true,
  "description": "A self-hosted control plane for isolated official Supabase deployments.",
  "repository": {
    "type": "git",
    "url": "https://github.com/skuldgerry/supabase-manager.git"
  },
  "scripts": {
    "dev": "next dev",
