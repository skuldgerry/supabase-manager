# syntax=docker/dockerfile:1

# Builds the pinned Studio/Multi-Head UI from studio-ui/ while keeping the
# existing broker image in Dockerfile. The two images stay separate until the
# broker API replaces Multi-Head's file stores and Docker orchestrator.

FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN apt-get update -qq && \
  apt-get install -y --no-install-recommends \
  git \
  python3 \
  ca-certificates \
  build-essential && \
  rm -rf /var/lib/apt/lists/* && \
  update-ca-certificates

RUN npm install -g pnpm@10.24.0
WORKDIR /app

FROM base AS turbo
COPY studio-ui/ .
RUN pnpm dlx turbo@2.9.3 prune studio --docker

FROM base AS dependencies
COPY --from=turbo /app/out/json ./
COPY --from=turbo /app/out/pnpm-lock.yaml ./
COPY studio-ui/patches/ ./patches/
RUN pnpm install --frozen-lockfile

FROM dependencies AS builder
COPY --from=turbo /app/out/full ./
# Turborepo's pruned output can omit the tracked declaration assets that the
# Functions editor imports as raw text. Keep the upstream files verbatim.
COPY studio-ui/apps/studio/public/deno/ ./apps/studio/public/deno/

# Manager authentication is local to the control plane. Child Supabase stacks
# retain their own independent Auth services.
ARG NEXT_PUBLIC_STUDIO_AUTH=manager
ENV NEXT_PUBLIC_STUDIO_AUTH=${NEXT_PUBLIC_STUDIO_AUTH}
ENV NODE_OPTIONS="--max-old-space-size=3600" \
  NEXT_TELEMETRY_DISABLED=1 \
  NEXT_BUILD_CPUS=1

RUN pnpm --filter studio exec next build --webpack

FROM base AS production
COPY --from=builder /app/apps/studio/public ./apps/studio/public
COPY --from=builder /app/apps/studio/.next/standalone ./
COPY --from=builder /app/apps/studio/.next/static ./apps/studio/.next/static

COPY scripts/studio-entrypoint.sh /usr/local/bin/supabase-manager-studio-entrypoint
RUN chmod 0755 /usr/local/bin/supabase-manager-studio-entrypoint \
  && mkdir -p /data

ENV NODE_ENV=production \
  STUDIO_DATA_DIR=/data \
  MANAGER_BROKER_URL=http://broker:3001 \
  MANAGER_INTERNAL_TOKEN_FILE=/run/supabase-manager/internal-token \
  NEXT_PUBLIC_STUDIO_AUTH=manager

EXPOSE 3000
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/supabase-manager-studio-entrypoint"]
HEALTHCHECK --interval=5s --timeout=5s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/api/self-hosted/session').then((response) => { if (response.status !== 200) throw new Error(response.status) })"
CMD ["node", "apps/studio/server.js"]
