# syntax=docker/dockerfile:1

# Builds the pinned Studio/Multi-Head UI from studio-ui/ while keeping the
# existing broker image in Dockerfile. The two images stay separate until the
# broker API replaces Multi-Head's file stores and Docker orchestrator.

FROM node:22-slim AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN apt-get update -qq && \
  apt-get install -y --no-install-recommends \
  git \
  python3 \
  ca-certificates \
  build-essential && \
  rm -rf /var/lib/apt/lists/* && \
  update-ca-certificates

RUN npm install -g pnpm@10.24.0
WORKDIR /app

FROM base AS turbo
COPY studio-ui/ .
RUN pnpm dlx turbo@2.9.3 prune studio --docker

FROM base AS dependencies
COPY --from=turbo /app/out/json ./
COPY --from=turbo /app/out/pnpm-lock.yaml ./
COPY studio-ui/patches/ ./patches/
RUN pnpm install --frozen-lockfile

FROM dependencies AS builder
COPY --from=turbo /app/out/full ./

# Multi-Head uses GoTrue-backed manager authentication. This will be replaced
# by the broker session adapter after the UI parity milestone.
ARG NEXT_PUBLIC_STUDIO_AUTH=gotrue
ENV NEXT_PUBLIC_STUDIO_AUTH=${NEXT_PUBLIC_STUDIO_AUTH}
ENV NODE_OPTIONS="--max-old-space-size=3072"

RUN pnpm --filter studio exec next build --webpack

FROM docker:27-cli AS docker-tools
RUN set -e; \
  plugin=$(find /usr -name docker-compose -type f 2>/dev/null | head -1); \
  test -n "$plugin"; \
  cp "$plugin" /docker-compose

FROM base AS production
COPY --from=builder /app/apps/studio/public ./apps/studio/public
COPY --from=builder /app/apps/studio/.next/standalone ./
COPY --from=builder /app/apps/studio/.next/static ./apps/studio/.next/static

# Retained temporarily because the UI baseline still contains Multi-Head's
# project APIs. The final UI image will not mount docker.sock; only the broker
# will have Docker access.
COPY --from=docker:27-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-tools /docker-compose /usr/local/lib/docker/cli-plugins/docker-compose
COPY studio-ui/docker/docker-compose.yml /app/supabase-docker/docker-compose.yml
COPY studio-ui/docker/volumes/ /app/supabase-docker/volumes/

ENV SUPABASE_COMPOSE_FILE=/app/supabase-docker/docker-compose.yml

EXPOSE 3000
ENTRYPOINT ["docker-entrypoint.sh"]
HEALTHCHECK --interval=5s --timeout=5s --retries=3 \
  CMD node -e "fetch('http://localhost:3000/api/self-hosted/session').then((response) => { if (response.status !== 200) throw new Error(response.status) })"
CMD ["node", "apps/studio/server.js"]
